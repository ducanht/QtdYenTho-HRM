rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Models & Schema - QTDND Yên Thọ HRM
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // 1. Kiểm tra người dùng đã đăng nhập qua Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. Kiểm tra Super Admin / Lãnh đạo cấp cao theo Email trực tiếp từ Auth Token
    // (Xác thực tức thì bằng JWT Token, độc lập 100% với việc đọc CSDL, không bao giờ lỗi)
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in [
          'ducanht@gmail.com',
          'nguyenducthao.qtd@gmail.com',
          'ducanht.gemini@gmail.com'
        ] ||
        request.auth.token.email.matches('.*admin.*') ||
        request.auth.token.email.matches('.*chutich.*')
      );
    }

    // 3. Kiểm tra vai trò quản lý trong CSDL (bọc an toàn bằng exists chống lỗi thiếu document)
    function hasAdminRoleInDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
          'admin', 'ADMIN', 'manager', 'MANAGER', 'chairman', 'CHAIRMAN'
        ];
    }

    // 4. Kiểm tra quyền Quản lý / Lãnh đạo chung
    function isManagerOrChairman() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        hasAdminRoleInDoc() ||
        request.auth.token.email.matches('.*quanly.*')
      );
    }

    // 5. Kiểm tra quyền sở hữu hồ sơ (hỗ trợ cả UID, authUid và email)
    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (resource != null && 'authUid' in resource.data && resource.data.authUid == request.auth.uid) ||
        (resource != null && 'email' in resource.data && resource.data.email == request.auth.token.email)
      );
    }

    // ===============================================================
    // 1. Hồ sơ Cán bộ (users)
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Quản trị viên (Chủ tịch / Giám đốc) hoặc chính chủ được sửa
      allow update: if isAuthenticated() && (
        isManagerOrChairman() ||
        isOwner(userId)
      );
      allow delete: if isManagerOrChairman();
    }

    // ===============================================================
    // 2. Quá trình Luân chuyển công tác (work_history)
    // ===============================================================
    match /work_history/{historyId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isManagerOrChairman();
    }

    // ===============================================================
    // 3. Đợt Đánh giá Tín nhiệm (evaluation_periods)
    // ===============================================================
    match /evaluation_periods/{periodId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isManagerOrChairman();
    }

    // ===============================================================
    // 4. Danh mục Tiêu chí Tín nhiệm (trust_criteria)
    // ===============================================================
    match /trust_criteria/{criterionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isManagerOrChairman();
    }

    // ===============================================================
    // 5. Phiếu Đánh giá Tín nhiệm (evaluations_trust)
    // ===============================================================
    match /evaluations_trust/{evalId} {
      allow read: if isAuthenticated();
      // Cho phép cán bộ nộp phiếu đánh giá (không tự chấm cho mình, trừ admin khi test)
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        !('targetEmployeeId' in request.resource.data) ||
        request.resource.data.evaluatorId != request.resource.data.targetEmployeeId
      );
      allow update: if isAuthenticated() && (
        isManagerOrChairman() ||
        isOwner(resource.data.evaluatorId)
      );
      allow delete: if isManagerOrChairman();
    }

    // ===============================================================
    // 6. Chấm điểm KPI 3 Cấp (evaluations_kpi)
    // ===============================================================
    match /evaluations_kpi/{kpiId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isManagerOrChairman();
    }

    // ===============================================================
    // 7. Bỏ phiếu Quy hoạch Cán bộ (evaluations_planning)
    // ===============================================================
    match /evaluations_planning/{planningId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isManagerOrChairman();
    }

    // ===============================================================
    // 8. Danh mục Phân hệ Hệ thống (system_modules)
    // ===============================================================
    match /system_modules/{moduleCode} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isManagerOrChairman();
    }

    // ===============================================================
    // 9. Ma trận Phân quyền (roles_permissions)
    // ===============================================================
    match /roles_permissions/{roleKey} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isManagerOrChairman();
    }

    // ===============================================================
    // 10. Siêu dữ liệu & Phiên bản CSDL Tự Động (system_metadata)
    // ===============================================================
    match /system_metadata/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isManagerOrChairman();
    }

    // ===============================================================
    // 11. Danh mục Phòng ban (departments)
    // ===============================================================
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isManagerOrChairman();
    }

    // ===============================================================
    // 12. Danh mục Chức danh (positions)
    // ===============================================================
    match /positions/{posId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isManagerOrChairman();
    }

    // ===============================================================
    // 13. Cấu hình Hệ thống & Tham số (system_settings)
    // Bao gồm cấu hình chung (general) và cấu hình từng phân hệ (module_*)
    // ===============================================================
    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isManagerOrChairman();
    }
  }
}
