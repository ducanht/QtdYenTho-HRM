rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Models & Schema - QTDND Yên Thọ HRM
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // 1. Kiểm tra người dùng đã đăng nhập qua Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. Tài khoản Quản trị Cấp cao DUY NHẤT (SuperAdmin): qtdyentho@gmail.com
    // Có đặc quyền duy nhất bật/tắt module webapp và cấu hình tham số webapp chung
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'qtdyentho@gmail.com';
    }

    // 3. Kiểm tra vai trò quản lý trong CSDL doc
    function hasAdminRoleInDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
          'superadmin', 'SUPERADMIN', 'admin', 'ADMIN', 'manager', 'MANAGER', 'chairman', 'CHAIRMAN'
        ];
    }

    // 4. Ban Quản trị & Điều hành (Admin: CT HĐQT, Giám đốc, TV HĐQT + SuperAdmin)
    function isBoardOrAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.email in [
          'ducanht@gmail.com',
          'ducanhqtdyt@gmail.com',
          'nguyenducthao.qtd@gmail.com',
          'ducanht.gemini@gmail.com',
          'sonqtdyt@gmail.com',
          'nguyenvansontdyt@gmail.com',
          'qtdyentho.vuhien@gmail.com'
        ] ||
        request.auth.token.email.matches('.*admin.*') ||
        request.auth.token.email.matches('.*chutich.*') ||
        request.auth.token.email.matches('.*giamdoc.*') ||
        request.auth.token.email.matches('.*hdqt.*') ||
        hasAdminRoleInDoc()
      );
    }


    // 5. Kiểm tra quyền sở hữu hồ sơ (hỗ trợ cả UID, authUid và email)
    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (resource != null && 'authUid' in resource.data && resource.data.authUid == request.auth.uid) ||
        (resource != null && 'email' in resource.data && resource.data.email == request.auth.token.email)
      );
    }

    // ===============================================================
    // 1. Hồ sơ Cán bộ (users) & Danh bạ CBNV (employees)
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isBoardOrAdmin() || request.auth.uid == userId);
      // Quản trị viên (Chủ tịch / Giám đốc) hoặc chính chủ được sửa
      allow update: if isAuthenticated() && (
        isBoardOrAdmin() ||
        isOwner(userId)
      );
      allow delete: if isBoardOrAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create, delete: if isBoardOrAdmin();
      allow update: if isAuthenticated() && (
        isBoardOrAdmin() ||
        isOwner(employeeId)
      );
    }

    // ===============================================================
    // 1B. Bảng Tài Khoản & Phân Quyền (accounts)
    // BẢO MẬT: Chỉ Admin/SuperAdmin hoặc chính chủ đọc được tài khoản của mình
    // ===============================================================
    match /accounts/{accountId} {
      allow read: if isAuthenticated() && (
        isBoardOrAdmin() ||
        request.auth.uid == accountId ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
      allow create: if isBoardOrAdmin();
      allow update: if isAuthenticated() && (
        isBoardOrAdmin() ||
        request.auth.uid == accountId ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
      allow delete: if isSuperAdmin();
    }

    // ===============================================================
    // 2. Quá trình Luân chuyển công tác (work_history)
    // ===============================================================
    match /work_history/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isBoardOrAdmin();
    }

    // ===============================================================
    // 3. Đợt Đánh giá Tín nhiệm (evaluation_periods)
    // ===============================================================
    match /evaluation_periods/{periodId} {
      allow read: if isAuthenticated();
      allow write: if isBoardOrAdmin();
    }

    // ===============================================================
    // 4. Danh mục Tiêu chí Tín nhiệm (trust_criteria)
    // ===============================================================
    match /trust_criteria/{criterionId} {
      allow read: if isAuthenticated();
      allow write: if isBoardOrAdmin();
    }

    // ===============================================================
    // 5. Phiếu Đánh giá Tín nhiệm (evaluations_trust)
    // ===============================================================
    match /evaluations_trust/{evalId} {
      allow read: if isAuthenticated();
      // Cho phép cán bộ nộp phiếu đánh giá (không tự chấm cho mình trừ khi đợt bật allowSelfEvaluation hoặc Admin)
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        !('targetEmployeeId' in request.resource.data) ||
        request.resource.data.evaluatorId != request.resource.data.targetEmployeeId ||
        request.resource.data.allowSelfEvaluation == true
      );
      allow update: if isAuthenticated() && (
        isBoardOrAdmin() ||
        isOwner(resource.data.evaluatorId)
      );
      allow delete: if isBoardOrAdmin();
    }

    // ===============================================================
    // 6. Chấm điểm KPI 3 Cấp (evaluations_kpi)
    // ===============================================================
    match /evaluations_kpi/{kpiId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isBoardOrAdmin() || (resource != null && resource.data.employeeId == request.auth.uid);
    }

    // ===============================================================
    // 7. Bỏ phiếu Quy hoạch Cán bộ (evaluations_planning)
    // ===============================================================
    match /evaluations_planning/{planningId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isBoardOrAdmin();
    }

    // ===============================================================
    // 8. Danh mục Phân hệ Hệ thống (system_modules)
    // BẢO MẬT: Chỉ SuperAdmin và Ban Lãnh đạo mới có quyền ghi/bật/tắt phân hệ
    // ===============================================================
    match /system_modules/{moduleCode} {
      allow read: if isAuthenticated();
      allow write: if isBoardOrAdmin();
    }

    // ===============================================================
    // 9. Ma trận Phân quyền (roles_permissions)
    // BẢO MẬT: Chỉ SuperAdmin mới có quyền sửa đổi ma trận quyền hệ thống
    // ===============================================================
    match /roles_permissions/{roleKey} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ===============================================================
    // 10. Siêu dữ liệu & Phiên bản CSDL Tự Động (system_metadata)
    // BẢO MẬT: Chỉ Admin/SuperAdmin mới được phép cập nhật version schema
    // ===============================================================
    match /system_metadata/{docId} {
      allow read: if isAuthenticated();
      allow write: if isBoardOrAdmin();
    }

    // ===============================================================
    // 11. Danh mục Phòng ban (departments)
    // ===============================================================
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isBoardOrAdmin();
    }

    // ===============================================================
    // 12. Danh mục Chức danh (positions)
    // ===============================================================
    match /positions/{posId} {
      allow read: if isAuthenticated();
      allow write: if isBoardOrAdmin();
    }

    // ===============================================================
    // 13. Cấu hình Hệ thống & Tham số (system_settings)
    // ===============================================================
    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isBoardOrAdmin();
    }

    // ===============================================================
    // 14. Cấu hình Riêng Biệt Từng Đợt Đánh Giá (period_configs)
    // ===============================================================
    match /period_configs/{periodId} {
      allow read: if isAuthenticated();
      allow write: if isBoardOrAdmin();
    }
  }
}
